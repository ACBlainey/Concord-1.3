{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:concord:bsr:schema:002",
  "title": "Concord Bootstrap Service Registry Record Schema 002",
  "description": "Serialization candidate derived from BSR Model 002. Structural validity does not establish semantic conformance, service legitimacy, or authority.",
  "type": "object",
  "required": ["record_meta","service_identity","control_relations","status","function_profiles","provenance","trust_evidence","continuity","temporal_state","relations","corrections","disputes","extensions"],
  "properties": {
    "record_meta":{"$ref":"#/$defs/recordMeta"},
    "service_identity":{"$ref":"#/$defs/serviceIdentity"},
    "control_relations":{"type":"array","items":{"$ref":"#/$defs/controlRelation"}},
    "status":{"$ref":"#/$defs/status"},
    "function_profiles":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/functionProfile"}},
    "provenance":{"$ref":"#/$defs/provenance"},
    "trust_evidence":{"$ref":"#/$defs/trustEvidence"},
    "continuity":{"$ref":"#/$defs/continuity"},
    "temporal_state":{"$ref":"#/$defs/temporalState"},
    "relations":{"type":"array","items":{"$ref":"#/$defs/serviceRelation"}},
    "corrections":{"type":"array","items":{"$ref":"#/$defs/materialCorrection"}},
    "disputes":{"type":"array","items":{"$ref":"#/$defs/disputeRecord"}},
    "extensions":{"type":"array","items":{"$ref":"#/$defs/extensionEntry"}}
  },
  "additionalProperties":false,
  "$defs":{
    "nonEmptyString":{"type":"string","minLength":1},
    "timestamp":{"type":"string","format":"date-time"},
    "vocabularyToken":{
      "type":"object",
      "required":["namespace","version","token"],
      "properties":{
        "namespace":{"$ref":"#/$defs/nonEmptyString"},
        "version":{"$ref":"#/$defs/nonEmptyString"},
        "token":{"$ref":"#/$defs/nonEmptyString"},
        "recognition_state":{"type":"string","enum":["RECOGNISED","UNRECOGNISED"]}
      },
      "additionalProperties":false
    },
    "verificationState":{"type":"string","enum":["VERIFIED_TO_DECLARED_SCOPE","PARTIALLY_VERIFIED","UNVERIFIED","DISPUTED","UNKNOWN"]},
    "integrityState":{"type":"string","enum":["VERIFIED_INTACT","PARTIALLY_VERIFIED","UNVERIFIED","COMPROMISED","UNKNOWN"]},
    "freshnessState":{"type":"string","enum":["CURRENT","STALE","SUPERSEDED","UNKNOWN"]},
    "disputeState":{"type":"string","enum":["NONE_KNOWN","OPEN","DISPUTED","RESOLVED","UNKNOWN"]},
    "reference":{
      "type":"object","required":["reference_type","reference_value","verification_state"],
      "properties":{
        "reference_type":{"$ref":"#/$defs/vocabularyToken"},
        "reference_value":{"$ref":"#/$defs/nonEmptyString"},
        "issuer_or_source":{"type":["string","null"]},
        "verification_state":{"$ref":"#/$defs/verificationState"},
        "observed_at":{"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},
        "evidence_refs":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"}}
      },"additionalProperties":false
    },
    "recordMeta":{
      "type":"object",
      "required":["registry_record_id","model_version","schema_version","vocabulary_version","record_created_at","record_observed_at","record_updated_at"],
      "properties":{
        "registry_record_id":{"$ref":"#/$defs/nonEmptyString"},
        "model_version":{"const":"BSR-MODEL-002"},
        "schema_version":{"const":"BSR-SCHEMA-002"},
        "vocabulary_version":{"$ref":"#/$defs/nonEmptyString"},
        "record_created_at":{"$ref":"#/$defs/timestamp"},
        "record_observed_at":{"$ref":"#/$defs/timestamp"},
        "record_updated_at":{"$ref":"#/$defs/timestamp"},
        "registry_identity_reference":{"anyOf":[{"$ref":"#/$defs/reference"},{"type":"null"}]}
      },"additionalProperties":false
    },
    "serviceIdentity":{
      "type":"object","required":["service_name","service_type","service_identity_references"],
      "properties":{
        "service_name":{"$ref":"#/$defs/nonEmptyString"},
        "service_type":{"$ref":"#/$defs/vocabularyToken"},
        "service_identity_references":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/reference"}},
        "previous_names":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"}},
        "contact_routes":{"type":"array","items":{"$ref":"#/$defs/reference"}}
      },"additionalProperties":false
    },
    "controlRelation":{
      "type":"object","required":["actor_reference","control_role","scope","observed_at","verification_state"],
      "properties":{
        "actor_reference":{"$ref":"#/$defs/reference"},
        "control_role":{"$ref":"#/$defs/vocabularyToken"},
        "scope":{"$ref":"#/$defs/nonEmptyString"},
        "effective_from":{"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},
        "effective_until":{"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},
        "observed_at":{"$ref":"#/$defs/timestamp"},
        "evidence_refs":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"}},
        "verification_state":{"$ref":"#/$defs/verificationState"}
      },"additionalProperties":false
    },
    "status":{
      "type":"object","required":["claimed_service_status","evidence_supported_status","developmental_state"],
      "properties":{
        "claimed_service_status":{"$ref":"#/$defs/vocabularyToken"},
        "evidence_supported_status":{"$ref":"#/$defs/vocabularyToken"},
        "developmental_state":{"$ref":"#/$defs/vocabularyToken"},
        "summary_availability":{
          "type":["object","null"],
          "properties":{
            "value":{"$ref":"#/$defs/vocabularyToken"},
            "derivation_rule":{"$ref":"#/$defs/nonEmptyString"},
            "declared_as_summary":{"const":true}
          },"required":["value","derivation_rule","declared_as_summary"],"additionalProperties":false
        }
      },"additionalProperties":false
    },
    "authorityProfile":{
      "type":"object","required":["authority_claim","authority_basis","authority_scope","verification_state"],
      "properties":{
        "authority_claim":{"type":["string","null"]},
        "authority_basis":{"type":["string","null"]},
        "authority_scope":{"type":["string","null"]},
        "sunset_or_review":{"type":["string","null"]},
        "verification_state":{"$ref":"#/$defs/verificationState"},
        "evidence_refs":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"}}
      },"additionalProperties":false
    },
    "dependencyRelation":{
      "type":"object","required":["dependency_reference","dependency_type","scope","current_availability","verification_state"],
      "properties":{
        "dependency_reference":{"$ref":"#/$defs/reference"},
        "dependency_type":{"$ref":"#/$defs/vocabularyToken"},
        "scope":{"$ref":"#/$defs/nonEmptyString"},
        "necessity_or_criticality":{"type":["string","null"]},
        "current_availability":{"$ref":"#/$defs/vocabularyToken"},
        "common_dependency_reference":{"anyOf":[{"$ref":"#/$defs/reference"},{"type":"null"}]},
        "evidence_refs":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"}},
        "verification_state":{"$ref":"#/$defs/verificationState"}
      },"additionalProperties":false
    },
    "temporalState":{
      "type":"object","required":["observed_at","freshness_state"],
      "properties":{
        "created_at":{"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},
        "observed_at":{"$ref":"#/$defs/timestamp"},
        "effective_from":{"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},
        "effective_until":{"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},
        "updated_at":{"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},
        "freshness_state":{"$ref":"#/$defs/freshnessState"}
      },"additionalProperties":false
    },
    "functionProfile":{
      "type":"object",
      "required":["function_id","declared_function","bootstrap_class","population_or_objects_served","material_consequences","authority_profile","constitutional_threshold_state","operational_availability","dependencies","evidence_refs","temporal_state"],
      "properties":{
        "function_id":{"$ref":"#/$defs/nonEmptyString"},
        "declared_function":{"$ref":"#/$defs/nonEmptyString"},
        "bootstrap_class":{"$ref":"#/$defs/vocabularyToken"},
        "population_or_objects_served":{"$ref":"#/$defs/nonEmptyString"},
        "material_consequences":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"}},
        "authority_profile":{"$ref":"#/$defs/authorityProfile"},
        "constitutional_threshold_state":{"$ref":"#/$defs/vocabularyToken"},
        "operational_availability":{"$ref":"#/$defs/vocabularyToken"},
        "dependencies":{"type":"array","items":{"$ref":"#/$defs/dependencyRelation"}},
        "evidence_refs":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"}},
        "temporal_state":{"$ref":"#/$defs/temporalState"}
      },"additionalProperties":false
    },
    "evidenceReference":{
      "type":"object","required":["evidence_id","evidence_type","source","observed_at","supported_claim_scope","verification_state"],
      "properties":{
        "evidence_id":{"$ref":"#/$defs/nonEmptyString"},
        "evidence_type":{"$ref":"#/$defs/vocabularyToken"},
        "source":{"$ref":"#/$defs/nonEmptyString"},
        "observed_at":{"$ref":"#/$defs/timestamp"},
        "integrity_reference":{"type":["string","null"]},
        "supported_claim_scope":{"$ref":"#/$defs/nonEmptyString"},
        "verification_state":{"$ref":"#/$defs/verificationState"},
        "dependency_or_independence_note":{"type":["string","null"]},
        "dispute_refs":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"}},
        "correction_refs":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"}}
      },"additionalProperties":false
    },
    "provenance":{
      "type":"object","required":["source_architecture","implementation_version","artifact_provenance","service_dependencies"],
      "properties":{
        "source_architecture":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"}},
        "implementation_version":{"$ref":"#/$defs/nonEmptyString"},
        "artifact_provenance":{"type":"array","items":{"$ref":"#/$defs/reference"}},
        "service_dependencies":{"type":"array","items":{"$ref":"#/$defs/dependencyRelation"}}
      },"additionalProperties":false
    },
    "trustEvidence":{
      "type":"object","required":["integrity_state","verification_state","evidence_timestamp","dispute_state","evidence"],
      "properties":{
        "integrity_state":{"$ref":"#/$defs/integrityState"},
        "verification_state":{"$ref":"#/$defs/verificationState"},
        "evidence_timestamp":{"$ref":"#/$defs/timestamp"},
        "dispute_state":{"$ref":"#/$defs/disputeState"},
        "evidence":{"type":"array","items":{"$ref":"#/$defs/evidenceReference"}}
      },"additionalProperties":false
    },
    "continuity":{
      "type":"object","required":["succession_plan","exit_or_portability","failure_or_recovery_route","retirement_condition"],
      "properties":{
        "succession_plan":{"type":["string","null"]},
        "exit_or_portability":{"type":["string","null"]},
        "failure_or_recovery_route":{"type":["string","null"]},
        "retirement_condition":{"type":["string","null"]}
      },"additionalProperties":false
    },
    "serviceRelation":{
      "type":"object","required":["relation_type","related_service_reference","scope","verification_state"],
      "properties":{
        "relation_type":{"$ref":"#/$defs/vocabularyToken"},
        "related_service_reference":{"$ref":"#/$defs/reference"},
        "scope":{"$ref":"#/$defs/nonEmptyString"},
        "effective_time":{"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},
        "evidence_refs":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"}},
        "verification_state":{"$ref":"#/$defs/verificationState"}
      },"additionalProperties":false
    },
    "materialCorrection":{
      "type":"object","required":["correction_id","target_reference","corrected_at","reason"],
      "properties":{
        "correction_id":{"$ref":"#/$defs/nonEmptyString"},
        "target_reference":{"$ref":"#/$defs/nonEmptyString"},
        "prior_value_or_reference":{},
        "corrected_value_or_reference":{},
        "corrected_at":{"$ref":"#/$defs/timestamp"},
        "reason":{"$ref":"#/$defs/nonEmptyString"},
        "evidence_refs":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"}},
        "correcting_actor_or_process_reference":{"anyOf":[{"$ref":"#/$defs/reference"},{"type":"null"}]}
      },"additionalProperties":false
    },
    "disputeRecord":{
      "type":"object","required":["dispute_id","target_reference","dispute_type","opened_at","current_state"],
      "properties":{
        "dispute_id":{"$ref":"#/$defs/nonEmptyString"},
        "target_reference":{"$ref":"#/$defs/nonEmptyString"},
        "dispute_type":{"$ref":"#/$defs/vocabularyToken"},
        "claimant_references":{"type":"array","items":{"$ref":"#/$defs/reference"}},
        "competing_claim_references":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"}},
        "evidence_refs":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"}},
        "opened_at":{"$ref":"#/$defs/timestamp"},
        "current_state":{"$ref":"#/$defs/disputeState"},
        "resolution_reference":{"type":["string","null"]}
      },"additionalProperties":false
    },
    "extensionEntry":{
      "type":"object","required":["namespace","version","payload"],
      "properties":{
        "namespace":{"$ref":"#/$defs/nonEmptyString"},
        "version":{"$ref":"#/$defs/nonEmptyString"},
        "payload":{}
      },"additionalProperties":false
    }
  }
}